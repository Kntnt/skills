{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kntnt.dev/schemas/model-selector/adapter-template-v1.json",
  "title": "Model-selector adapter template",
  "type": "object",
  "required": ["schema_version", "adapter_template_id", "harness", "surface", "covers", "model_source", "deliberation_source", "serving_modes", "launch"],
  "properties": {
    "schema_version": {"const": 1},
    "adapter_template_id": {"$ref": "#/$defs/non_empty_string"},
    "harness": {"$ref": "#/$defs/non_empty_string"},
    "surface": {"$ref": "#/$defs/non_empty_string"},
    "covers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_empty_string"}},
    "model_source": {"enum": ["canonical", "family_alias"]},
    "accepted_model_aliases": {"type": "array", "items": {"$ref": "#/$defs/non_empty_string"}},
    "deliberation_source": {"enum": ["portable", "carried"]},
    "supported_deliberation": {"type": "array", "items": {"enum": ["low", "medium", "high", "xhigh", "max"]}},
    "serving_modes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_empty_string"}},
    "launch": {"$ref": "https://kntnt.dev/schemas/model-selector/route-request-v1.json#/$defs/launch_translation"}
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1}
  }
}
