{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kntnt.dev/schemas/model-selector/route-request-v1.json",
  "title": "Model-selector route request",
  "type": "object",
  "required": ["schema_version", "requests"],
  "properties": {
    "schema_version": {"const": 1},
    "requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/request"}},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "context": {"$ref": "#/$defs/context"}
  },
  "oneOf": [
    {"required": ["snapshot"], "not": {"required": ["context"]}},
    {"required": ["context"], "not": {"required": ["snapshot"]}}
  ],
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "string_array": {"type": "array", "items": {"$ref": "#/$defs/non_empty_string"}},
    "nullable_number": {"type": ["number", "null"]},
    "native_control": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "policy": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "checker": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "signal"],
          "properties": {
            "kind": {"enum": ["external", "declared"]},
            "signal": {"$ref": "#/$defs/non_empty_string"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "none"}},
          "additionalProperties": false
        }
      ]
    },
    "exact_attempt": {
      "type": "object",
      "required": ["configuration_fingerprint", "model", "channel", "surface", "serving_mode", "adapter_id", "portable_deliberation", "native_deliberation"],
      "properties": {
        "configuration_fingerprint": {"$ref": "#/$defs/non_empty_string"},
        "model": {"$ref": "#/$defs/non_empty_string"},
        "channel": {"$ref": "#/$defs/non_empty_string"},
        "surface": {"$ref": "#/$defs/non_empty_string"},
        "serving_mode": {"$ref": "#/$defs/non_empty_string"},
        "adapter_id": {"$ref": "#/$defs/non_empty_string"},
        "portable_deliberation": {"enum": ["low", "medium", "high", "xhigh", "max"]},
        "native_deliberation": {"$ref": "#/$defs/native_control"}
      },
      "additionalProperties": false
    },
    "verified_failure": {
      "type": "object",
      "required": ["configuration_fingerprint", "model", "channel", "surface", "serving_mode", "adapter_id", "portable_deliberation", "native_deliberation", "outcome", "checker"],
      "properties": {
        "configuration_fingerprint": {"$ref": "#/$defs/non_empty_string"},
        "model": {"$ref": "#/$defs/non_empty_string"},
        "channel": {"$ref": "#/$defs/non_empty_string"},
        "surface": {"$ref": "#/$defs/non_empty_string"},
        "serving_mode": {"$ref": "#/$defs/non_empty_string"},
        "adapter_id": {"$ref": "#/$defs/non_empty_string"},
        "portable_deliberation": {"enum": ["low", "medium", "high", "xhigh", "max"]},
        "native_deliberation": {"$ref": "#/$defs/native_control"},
        "outcome": {"const": "failed"},
        "checker": {"$ref": "#/$defs/checker"}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["request_id", "authority", "stage", "workload", "workload_tags", "reversible", "checker", "overrides"],
      "properties": {
        "request_id": {"$ref": "#/$defs/non_empty_string"},
        "authority": {"enum": ["execution", "verdict"]},
        "stage": {"$ref": "#/$defs/non_empty_string"},
        "workload": {"$ref": "#/$defs/non_empty_string"},
        "workload_cohort": {"$ref": "#/$defs/non_empty_string"},
        "workload_tags": {"$ref": "#/$defs/string_array"},
        "required_capabilities": {"$ref": "#/$defs/string_array"},
        "reversible": {"type": "boolean"},
        "checker": {"$ref": "#/$defs/checker"},
        "overrides": {
          "type": "object",
          "properties": {
            "model": {"$ref": "#/$defs/non_empty_string"},
            "deliberation": {"enum": ["low", "medium", "high", "xhigh", "max"]}
          },
          "additionalProperties": false
        },
        "retry_available": {"type": "boolean"},
        "prior": {"$ref": "#/$defs/exact_attempt"},
        "verified_failure": {"$ref": "#/$defs/verified_failure"},
        "economics": {"$ref": "#/$defs/economics"}
      },
      "additionalProperties": false
    },
    "economics": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": {"enum": ["route", "renew"]},
        "budget": {"type": "number"},
        "quality_floor": {"type": "number"}
      },
      "not": {"required": ["budget", "quality_floor"]},
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["revision", "valid"],
      "properties": {
        "revision": {"$ref": "#/$defs/non_empty_string"},
        "valid": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": ["lower_bound", "upper_bound"],
      "properties": {
        "lower_bound": {"type": "number"},
        "upper_bound": {"type": "number"}
      },
      "additionalProperties": false
    },
    "evidence_record": {
      "type": "object",
      "required": ["configuration_fingerprint", "model", "portable_deliberation", "native_deliberation", "channel", "harness", "surface", "serving_mode", "stage", "workload_cohort", "workload_tags", "representative", "coverage", "uncertainty", "quality", "stale"],
      "properties": {
        "configuration_fingerprint": {"$ref": "#/$defs/non_empty_string"},
        "model": {"$ref": "#/$defs/non_empty_string"},
        "portable_deliberation": {"enum": ["low", "medium", "high", "xhigh", "max"]},
        "native_deliberation": {"$ref": "#/$defs/native_control"},
        "channel": {"$ref": "#/$defs/non_empty_string"},
        "harness": {"$ref": "#/$defs/non_empty_string"},
        "surface": {"$ref": "#/$defs/non_empty_string"},
        "serving_mode": {"$ref": "#/$defs/non_empty_string"},
        "stage": {"$ref": "#/$defs/non_empty_string"},
        "workload_cohort": {"$ref": "#/$defs/non_empty_string"},
        "workload_tags": {"$ref": "#/$defs/string_array"},
        "representative": {"type": "boolean"},
        "coverage": {
          "type": "object",
          "required": ["decision_relevant"],
          "properties": {"decision_relevant": {"type": "boolean"}},
          "additionalProperties": false
        },
        "uncertainty": {"oneOf": [{"$ref": "#/$defs/uncertainty"}, {"type": "null"}]},
        "quality": {"type": "number"},
        "stale": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["identity", "vintage", "records"],
      "properties": {
        "identity": {"$ref": "#/$defs/non_empty_string"},
        "vintage": {"$ref": "#/$defs/non_empty_string"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/evidence_record"}}
      },
      "additionalProperties": false
    },
    "launch_translation": {
      "type": "object",
      "required": ["model_flag", "surface_flag", "serving_mode_flag", "native_control_flags", "tools_flag", "policy_flags"],
      "properties": {
        "model_flag": {"$ref": "#/$defs/non_empty_string"},
        "surface_flag": {"$ref": "#/$defs/non_empty_string"},
        "serving_mode_flag": {"$ref": "#/$defs/non_empty_string"},
        "native_control_flags": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/non_empty_string"}},
        "tools_flag": {"$ref": "#/$defs/non_empty_string"},
        "policy_flags": {"type": "object", "additionalProperties": {"$ref": "#/$defs/non_empty_string"}}
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["adapter_id", "channel", "harness", "surface", "models", "serving_modes", "native_controls", "tool_sets", "policies", "launch"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/non_empty_string"},
        "channel": {"$ref": "#/$defs/non_empty_string"},
        "harness": {"$ref": "#/$defs/non_empty_string"},
        "surface": {"$ref": "#/$defs/non_empty_string"},
        "models": {"$ref": "#/$defs/string_array"},
        "serving_modes": {"$ref": "#/$defs/string_array"},
        "native_controls": {"type": "array", "items": {"$ref": "#/$defs/native_control"}},
        "tool_sets": {"type": "array", "items": {"$ref": "#/$defs/string_array"}},
        "policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}},
        "launch": {"$ref": "#/$defs/launch_translation"}
      },
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "required": ["name", "surface", "inventory_revision", "inheritance", "adapter_specs"],
      "properties": {
        "name": {"$ref": "#/$defs/non_empty_string"},
        "surface": {"$ref": "#/$defs/non_empty_string"},
        "inventory_revision": {"$ref": "#/$defs/non_empty_string"},
        "inheritance": {"type": "boolean"},
        "adapter_specs": {"type": "array", "items": {"$ref": "#/$defs/adapter"}}
      },
      "additionalProperties": false
    },
    "main_seat": {
      "type": "object",
      "required": ["model", "channel", "surface", "serving_mode", "adapter_id", "native_deliberation", "portable_deliberation", "model_capability", "deliberation_capability", "tools", "policy"],
      "properties": {
        "model": {"$ref": "#/$defs/non_empty_string"},
        "channel": {"$ref": "#/$defs/non_empty_string"},
        "surface": {"$ref": "#/$defs/non_empty_string"},
        "serving_mode": {"$ref": "#/$defs/non_empty_string"},
        "adapter_id": {"$ref": "#/$defs/non_empty_string"},
        "native_deliberation": {"$ref": "#/$defs/native_control"},
        "portable_deliberation": {"enum": ["low", "medium", "high", "xhigh", "max"]},
        "model_capability": {"$ref": "#/$defs/nullable_number"},
        "deliberation_capability": {"$ref": "#/$defs/nullable_number"},
        "tools": {"$ref": "#/$defs/string_array"},
        "policy": {"$ref": "#/$defs/policy"}
      },
      "additionalProperties": false
    },
    "commercial": {
      "type": "object",
      "required": ["cash", "rolling_quota", "weekly_quota", "allocated_subscription_cost", "latency"],
      "properties": {
        "cash": {"$ref": "#/$defs/nullable_number"},
        "rolling_quota": {"$ref": "#/$defs/nullable_number"},
        "weekly_quota": {"$ref": "#/$defs/nullable_number"},
        "allocated_subscription_cost": {"$ref": "#/$defs/nullable_number"},
        "latency": {"$ref": "#/$defs/nullable_number"}
      },
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "required": ["model", "aliases", "channel", "surface", "serving_mode", "model_capability", "controls", "control_capabilities", "native_control_order", "tools", "policy", "capabilities", "commercial", "enabled"],
      "properties": {
        "model": {"$ref": "#/$defs/non_empty_string"},
        "aliases": {"$ref": "#/$defs/string_array"},
        "channel": {"$ref": "#/$defs/non_empty_string"},
        "surface": {"$ref": "#/$defs/non_empty_string"},
        "serving_mode": {"$ref": "#/$defs/non_empty_string"},
        "model_capability": {"type": "number"},
        "controls": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "low": {"$ref": "#/$defs/native_control"},
            "medium": {"$ref": "#/$defs/native_control"},
            "high": {"$ref": "#/$defs/native_control"},
            "xhigh": {"$ref": "#/$defs/native_control"},
            "max": {"$ref": "#/$defs/native_control"}
          },
          "additionalProperties": false
        },
        "control_capabilities": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "low": {"type": "number"},
            "medium": {"type": "number"},
            "high": {"type": "number"},
            "xhigh": {"type": "number"},
            "max": {"type": "number"}
          },
          "additionalProperties": false
        },
        "native_control_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/native_control"}},
        "tools": {"$ref": "#/$defs/string_array"},
        "policy": {"$ref": "#/$defs/policy"},
        "capabilities": {"$ref": "#/$defs/string_array"},
        "commercial": {"$ref": "#/$defs/commercial"},
        "enabled": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "shadow_prices": {
      "type": "object",
      "required": ["rolling_quota", "weekly_quota", "allocated_subscription_cost", "latency"],
      "properties": {
        "rolling_quota": {"type": "number"},
        "weekly_quota": {"type": "number"},
        "allocated_subscription_cost": {"type": "number"},
        "latency": {"type": "number"}
      },
      "additionalProperties": false
    },
    "override_policy": {
      "type": "object",
      "required": ["portable_levels", "cold_start", "quality_floor", "shadow_prices"],
      "properties": {
        "portable_levels": {"const": ["low", "medium", "high", "xhigh", "max"]},
        "cold_start": {"enum": ["select", "inherit"]},
        "quality_floor": {"type": "number"},
        "shadow_prices": {"oneOf": [{"$ref": "#/$defs/shadow_prices"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["snapshot_version", "profile", "evidence", "harness", "main_seat", "mappings", "override_policy"],
      "properties": {
        "snapshot_version": {"const": 1},
        "snapshot_identity": {"$ref": "#/$defs/non_empty_string"},
        "profile": {"oneOf": [{"$ref": "#/$defs/profile"}, {"type": "null"}]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "harness": {"$ref": "#/$defs/harness"},
        "main_seat": {"$ref": "#/$defs/main_seat"},
        "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}},
        "override_policy": {"$ref": "#/$defs/override_policy"}
      },
      "additionalProperties": false
    },
    "snapshot": {
      "allOf": [
        {"$ref": "#/$defs/context"},
        {"required": ["snapshot_identity"]}
      ]
    }
  }
}
